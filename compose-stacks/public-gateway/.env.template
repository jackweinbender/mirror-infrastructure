# public-gateway compose stack — secret template.
# At deploy time, `op inject` resolves op:// references and the result is
# piped directly to the VM as .env. Secrets never touch the runner's disk.
#
# Before deploying:
#   1. Run `terraform apply` in terraform/cloudflare/ (Plan 001).
#   2. Retrieve the tunnel token from the Cloudflare Zero Trust dashboard
#      (Networks → Tunnels → weinbender-io → Configure) and store it in
#      1Password at the path below. Do NOT use terraform output — the token
#      is not exposed as an output by design.
#   3. Create or reuse a Cloudflare API token with Zone:DNS:Edit permissions
#      for weinbender.io and store it in 1Password at the path below.
#   4. Update the op:// paths below to match your 1Password vault/item layout.
#
# Deploy metadata is appended automatically by the deploy workflow.

# Cloudflare Tunnel token (retrieved from CF Zero Trust dashboard after Plan 001 apply)
CLOUDFLARE_TUNNEL_TOKEN=op://network/tunnel-weinbender-io/token

# Cloudflare API token for Traefik ACME DNS-01 challenge (Zone:DNS:Edit)
CF_DNS_API_TOKEN=op://network/cloudflare-auth-weinbenderio/credential

# Cloudflare Tunnel secret template for the `docker-vm-dmz` assignment.
# Before enabling the assignment:
#   1. Run `terraform apply` in terraform/cloudflare/ (Plan 001).
#   2. Retrieve the tunnel token from Cloudflare Zero Trust → Networks →
#      Tunnels → weinbender-io → Configure, then store it in 1Password at the
#      path below. Do NOT use terraform output; the token is not exposed there.
#   3. Create or reuse a Cloudflare API token with Zone:DNS:Edit permissions
#      for weinbender.io and store it in 1Password at the path below.
#
# Keep 1Password references unresolved in this file. Never commit resolved
# values or a runtime `.env` file.

# Cloudflare Tunnel token (retrieved from CF Zero Trust dashboard after Plan 001 apply)
CLOUDFLARE_TUNNEL_TOKEN=op://network/cloudflare-tunnel-weinbender-io/credential

# Cloudflare API token for Traefik ACME DNS-01 challenge (Zone:DNS:Edit)
CF_DNS_API_TOKEN=op://network/cloudflare-auth-weinbenderio/credential

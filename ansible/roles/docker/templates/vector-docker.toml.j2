[sources.docker]
type = "docker_logs"
docker_host = "unix:///var/run/docker.sock"

[transforms.normalize_docker]
type = "remap"
inputs = ["docker"]
source = '''
.host = "{{ base_vector_host_id }}"
.source_type = "docker"
.app = .label."vector.app"
if is_null(.app) {
    .app = "unknown"
}

parsed, err = parse_json(.message)
if err == null && is_object(parsed) {
  severity = parsed.level
  if is_null(severity) {
    severity = parsed.severity
  }
  if is_null(severity) {
    severity = parsed.severity_text
  }
  if is_string(severity) {
    severity = downcase!(severity)
    if severity == "emergency" {
      .level = "emerg"
    } else if severity == "alert" {
      .level = "alert"
    } else if includes(["fatal", "panic", "critical"], severity) {
      .level = "crit"
    } else if includes(["error", "err"], severity) {
      .level = "err"
    } else if includes(["warn", "warning"], severity) {
      .level = "warning"
    } else if severity == "notice" {
      .level = "notice"
    } else if severity == "info" {
      .level = "info"
    } else if includes(["debug", "trace"], severity) {
      .level = "debug"
    }
  }
}
'''

[sinks.victorialogs_docker]
type = "elasticsearch"
inputs = ["normalize_docker"]
endpoints = ["{{ docker_vector_sink_endpoint }}"]
api_version = "v8"
mode = "bulk"
compression = "gzip"
healthcheck.enabled = false

[sinks.victorialogs_docker.query]
_msg_field = "message"
_time_field = "timestamp"
_stream_fields = "host,app,task"

[sinks.victorialogs_docker.buffer]
type = "disk"
max_size = {{ base_vector_buffer_max_size }}
when_full = "block"

data_dir = "/var/lib/vector"

# --- Local sources -----------------------------------------------------------

{% if vector_collect_docker | bool %}
[sources.docker]
type = "docker_logs"
docker_host = "unix://{{ vector_docker_socket }}"
{% endif %}

[sources.journald]
type = "journald"
current_boot_only = true
# Avoid a feedback loop: drop the collector's own systemd logs.
exclude_matches = { _SYSTEMD_UNIT = ["vector.service"] }

# --- Enrichment: stamp host identity and source type -------------------------

{% if vector_collect_docker | bool %}
[transforms.tag_docker]
type = "remap"
inputs = ["docker"]
source = '''
.host = "{{ vector_host_id }}"
.source_type = "docker"
'''
{% endif %}

[transforms.tag_journald]
type = "remap"
inputs = ["journald"]
source = '''
.host = "{{ vector_host_id }}"
.source_type = "journald"
'''

# --- Sink: central VictoriaLogs ----------------------------------------------

[sinks.victorialogs]
type = "http"
inputs = [{% if vector_collect_docker | bool %}"tag_docker", {% endif %}"tag_journald"]
uri = "{{ vector_sink_uri }}"
method = "post"
compression = "gzip"
encoding.codec = "json"
framing.method = "newline_delimited"
healthcheck.enabled = false

[sinks.victorialogs.buffer]
type = "disk"
max_size = {{ vector_buffer_max_size }}
when_full = "block"
#!/usr/bin/env bash
# stackctl: small Docker Compose stack reconciler.
set -Eeuo pipefail

STACK_ROOT=${STACKCTL_STACK_ROOT:-/opt/stacks}
STATE_ROOT=${STACKCTL_STATE_ROOT:-/var/lib/stackctl/managed}
LOCK_PATH=${STACKCTL_LOCK_PATH:-/run/lock/stackctl.lock}
SYSTEMCTL=${STACKCTL_SYSTEMCTL:-systemctl}
DOCKER=${STACKCTL_DOCKER:-docker}
UNIT_PREFIX=${STACKCTL_UNIT_PREFIX:-docker-compose@}
COMPOSE_FILE=${STACKCTL_COMPOSE_FILE:-compose.yaml}

log() { printf '%s\n' "$*"; }
err() { printf 'stackctl: %s\n' "$*" >&2; }
valid_stack() { [[ $1 =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; }
unit() { printf '%s%s.service' "$UNIT_PREFIX" "$1"; }
run() { "$@" || { err "command failed: $*"; return 1; }; }

lock_or_fail() {
  mkdir -p "$(dirname "$LOCK_PATH")"
  exec 9>"$LOCK_PATH"
  if ! flock -n 9; then
    err "another reconciliation is already running (lock: $LOCK_PATH)"
    return 75
  fi
}

stack_dirs() {
  [[ -d $STACK_ROOT ]] || return 0
  local dir name
  for dir in "$STACK_ROOT"/*; do
    [[ -d $dir && -f $dir/$COMPOSE_FILE ]] || continue
    name=${dir##*/}
    valid_stack "$name" || { err "invalid stack name: $name"; return 1; }
    printf '%s\n' "$name"
  done | sort
}
managed_stacks() {
  [[ -d $STATE_ROOT ]] || return 0
  local file name
  for file in "$STATE_ROOT"/*; do
    [[ -f $file ]] || continue
    name=${file##*/}
    valid_stack "$name" || { err "invalid managed state entry: $name"; return 1; }
    printf '%s\n' "$name"
  done | sort
}
is_enabled() { "$SYSTEMCTL" is-enabled --quiet "$(unit "$1")" >/dev/null 2>&1; }
is_active() { "$SYSTEMCTL" is-active --quiet "$(unit "$1")" >/dev/null 2>&1; }
mark_managed() { mkdir -p "$STATE_ROOT" && : > "$STATE_ROOT/$1"; }
unmark_managed() { rm -f -- "$STATE_ROOT/$1"; }
is_managed() { [[ -f $STATE_ROOT/$1 ]]; }


validate_stack() {
  local name=$1 dir=$STACK_ROOT/$1
  log "Validating $name..."
  (cd "$dir" && "$DOCKER" compose -p "$name" -f "$COMPOSE_FILE" config --quiet) || {
    err "validation failed for stack $name"
    return 1
  }
  log "Validating $name... ok"
}
compose_up() {
  local name=$1
  (cd "$STACK_ROOT/$name" && "$DOCKER" compose -p "$name" -f "$COMPOSE_FILE" up -d --remove-orphans)
}
compose_down_if_available() {
  local name=$1 dir=$STACK_ROOT/$1
  [[ -f $dir/$COMPOSE_FILE ]] || { log "Retiring $name... no Compose definition available; skipped down"; return 0; }
  (cd "$dir" && "$DOCKER" compose -p "$name" -f "$COMPOSE_FILE" down --remove-orphans)
}

reconcile() {
  lock_or_fail || return $?
  mkdir -p "$STATE_ROOT"
  local desired managed name failed=0 desired_output managed_output
  if ! desired_output=$(stack_dirs); then return 1; fi
  if ! managed_output=$(managed_stacks); then return 1; fi
  mapfile -t desired <<< "$desired_output"
  mapfile -t managed <<< "$managed_output"
  [[ -n $desired_output ]] || desired=()
  [[ -n $managed_output ]] || managed=()

  # Validate the complete desired set before any systemd or Docker mutation.
  for name in "${desired[@]}"; do
    [[ -n $name ]] || continue
    validate_stack "$name" || return 1
  done

  for name in "${desired[@]}"; do
    [[ -n $name ]] || continue
    if is_managed "$name" && is_active "$name" && is_enabled "$name"; then
      log "Updating $name..."
      if compose_up "$name"; then log "Updating $name... ok"; else err "update failed for $name"; failed=1; fi
    else
      log "Starting $name..."
      if run "$SYSTEMCTL" enable --now "$(unit "$name")"; then
        mark_managed "$name"; log "Starting $name... ok"
      else
        err "start failed for $name"; failed=1
      fi
    fi
  done
  (( failed == 0 )) || return 1

  for name in "${managed[@]}"; do
    [[ -e $STACK_ROOT/$name/$COMPOSE_FILE ]] && continue
    log "Retiring $name..."
    if run "$SYSTEMCTL" stop "$(unit "$name")" && run "$SYSTEMCTL" disable "$(unit "$name")" && compose_down_if_available "$name"; then
      unmark_managed "$name"; log "Retiring $name... ok"
    else
      err "retirement failed for $name"
      failed=1
    fi
  done
  (( failed == 0 )) || return 1
  log 'Reconciliation complete.'
}

list_stacks() {
  local -a desired=() managed=() name
  mapfile -t desired < <(stack_dirs)
  mapfile -t managed < <(managed_stacks)
  printf '%-20s %-8s %-8s %s\n' STACK DESIRED ENABLED STATE
  printf '%s\n' "${desired[@]}" "${managed[@]}" | sort -u | while IFS= read -r name; do
    [[ -n $name ]] || continue
    local d=no e=no s=stopped
    printf '%s\n' "${desired[@]}" | grep -Fxq "$name" && d=yes
    is_enabled "$name" && e=yes || true
    is_active "$name" && s=running || true
    printf '%-20s %-8s %-8s %s\n' "$name" "$d" "$e" "$s"
  done
}
status_stack() {
  local name=${1:-}
  [[ -n $name ]] || { list_stacks; return; }
  valid_stack "$name" || { err "invalid stack name: $name"; return 2; }
  "$SYSTEMCTL" status --no-pager "$(unit "$name")"
}
lifecycle() {
  local action=$1 name=$2
  valid_stack "$name" || { err "invalid stack name: $name"; return 2; }
  case $action in
    start) run "$SYSTEMCTL" enable --now "$(unit "$name")" && mark_managed "$name" ;;
    stop) run "$SYSTEMCTL" stop "$(unit "$name")" ;;
    restart) run "$SYSTEMCTL" restart "$(unit "$name")" ;;
  esac
}

case ${1:-} in
  reconcile) reconcile ;;
  list) list_stacks ;;
  status) status_stack "${2:-}" ;;
  validate)
    lock_or_fail || exit $?
    if [[ -n ${2:-} ]]; then validate_stack "$2"; else
      while IFS= read -r n; do [[ -n $n ]] && validate_stack "$n" || exit 1; done < <(stack_dirs)
    fi ;;
  start|stop|restart) [[ -n ${2:-} ]] || { err "usage: stackctl $1 STACK"; exit 2; }; lifecycle "$1" "$2" ;;
  *) err 'usage: stackctl {list|status [STACK]|start STACK|stop STACK|restart STACK|validate [STACK]|reconcile}'; exit 2 ;;
esac
